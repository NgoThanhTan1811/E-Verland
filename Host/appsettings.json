{
  "App": {
    "BackendUrl": "http://localhost:8080",
    "FrontendUrl": "http://localhost:3000"
  },
  "Jwt": {
    "Key": "Key_must_be_at_least_32_characters",
    "Issuer": "http://localhost:8080",
    "Audience": "http://localhost:8080",
    "AccessTokenMinutes": 10,
    "RefreshTokenHours": 12
  },
  "Cookie": {
    "Name": "access_token",
    "RefreshTokenName": "refresh_token",
    "Secure": true,
    "HttpOnly": true,
    "SameSite": "Lax",
    "Domain": "e-verland.site"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "https://e-verland.site"],
    "AllowCredentials": true
  },
  "Redis": {
    "Port": "16033",
    "Ssl": false,
    "AbortConnect": false
  },
  "Loki": {
    "Url": "http://localhost:3100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "LocalFile": {
      "Enabled": true,
      "Path": "logs/e-verland-.ndjson",
      "MinimumLevel": "Warning",
      "RetainedFileCountLimit": 14
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Payment": {
    "SePay": {
      "ApiKey": "",
      "SecretKey": "",
      "BaseUrl": "https://pgapi.sepay.vn",
      "MaxRetries": 3
    },
    "Payout": {
      "Scheduler": "Hangfire",
      "ReleaseDelayDays": 3
    }
  },
  "GHN": {
    "Token": "",
    "ShopId": 0,
    "BaseUrl": "https://dev-online-gateway.ghn.vn/shiip/public-api/v2",
    "MaxRetries": 3
  },
  "Storage": {
    "Provider": "S3",
    "BaseUrl": "",
    "ProductsPrefix": "products",
    "AvatarsPrefix": "avatars",
    "ShopsPrefix": "shops",
    "ReviewsPrefix": "reviews"
  },
  "Media": {
    "PresignedUrlExpirationMinutes": 10,
    "SmWidth": 480,
    "MdWidth": 1024,
    "LgWidth": 1920,
    "ImageCompressionQuality": 85,
    "OrphanGracePeriodHours": 24,
    "CleanupIntervalHours": 24
  },
  "Dashboard": {
    "RefreshIntervalMinutes": 15,
    "SnapshotTtlMinutes": 30,
    "StaleAfterMinutes": 15
  },
  "AWS": {
    "Region": "ap-southeast-1",
    "AccessKey": "",
    "SecretKey": "",
    "S3": {
      "BucketName": "e-verland-media",
      "Region": "auto",
      "BaseUrl": "",
      "ServiceUrl": "",
      "AccessKey": "your-r2-access-key",
      "SecretKey": "your-r2-secret-key",
      "ForcePathStyle": true,
      "AvatarPathPrefix": "avatars",
      "ProductImagePathPrefix": "products/images",
      "ProductVideoPathPrefix": "products/videos",
      "ShopLogoPathPrefix": "shops/logos",
      "ShopBannerPathPrefix": "shops/banners",
      "PreSignedUrlExpirationMinutes": 60
    },
    "SQS": {
      "OrderEventsQueueUrl": "https://sqs.ap-southeast-1.amazonaws.com/your-account-id/e-verland-order-events",
      "PaymentEventsQueueUrl": "https://sqs.ap-southeast-1.amazonaws.com/your-account-id/e-verland-payment-events",
      "ShippingDraftQueueUrl": "https://sqs.ap-southeast-1.amazonaws.com/your-account-id/e-verland-shipping-draft",
      "ShippingStatusQueueUrl": "https://sqs.ap-southeast-1.amazonaws.com/your-account-id/e-verland-shipping-status",
      "ProductSyncQueueUrl": "https://sqs.ap-southeast-1.amazonaws.com/your-account-id/e-verland-product-sync",
      "ProductSyncDeadLetterQueueUrl": "https://sqs.ap-southeast-1.amazonaws.com/your-account-id/e-verland-product-sync-dlq",
      "StockReserveQueueUrl": "https://sqs.ap-southeast-1.amazonaws.com/your-account-id/e-verland-stock-reserve",
      "MaxReceiveCount": 3
    },
    "SNS": {
      "NotificationTopicArn": "arn:aws:sns:ap-southeast-1:your-account-id:e-verland-notification-events",
      "OrderEventsTopicArn": "arn:aws:sns:ap-southeast-1:your-account-id:e-verland-order-events",
      "PaymentEventsTopicArn": "arn:aws:sns:ap-southeast-1:your-account-id:e-verland-payment-events",
      "ProductEventsTopicArn": "arn:aws:sns:ap-southeast-1:your-account-id:e-verland-product-events"
    },
    "EventBridge": {
      "EventBusName": "e-verland-events",
      "OrderEventSource": "e-verland.orders",
      "PaymentEventSource": "e-verland.payments",
      "ProductEventSource": "e-verland.products"
    },
    "XRay": {
      "Enabled": true
    },
    "Meilisearch": {
      "Endpoint": "http://localhost:7700",
      "MasterKey": "your-meilisearch-master-key",
      "IndexName": "products"
    },
    "CloudWatch": {
      "Enabled": true,
      "LogGroupName": "/ecs/e-verland-app",
      "LogStreamPrefix": "ecs",
      "CreateLogGroup": true,
      "BatchSizeLimit": 100,
      "QueueSizeLimit": 10000,
      "PeriodSeconds": 10,
      "RetryAttempts": 5
    }
  }
}
