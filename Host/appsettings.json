{
  "App": {
    "BackendUrl": "http://localhost:8080",
    "FrontendUrl": "http://localhost:3000"
  },
  "Jwt": {
    "Key": "your-jwt-key-min-32-chars-never-hardcode-in-production",
    "Issuer": "e-verland-platform",
    "Audience": "e-verland-platform",
    "AccessTokenMinutes": 10,
    "RefreshTokenHours": 12
  },
  "Cookie": {
    "Name": "access_token",
    "RefreshTokenName": "refresh_token",
    "Secure": true,
    "HttpOnly": true,
    "SameSite": "Lax",
    "Domain": "e-verland.site"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "https://e-verland.site"],
    "AllowCredentials": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Payment": {
    "SePay": {
      "ApiKey": "your-sepay-api-key",
      "SecretKey": "your-sepay-secret-key",
      "BaseUrl": "https://my.sepay.vn/userapi",
      "MaxRetries": 3
    },
    "Payout": {
      "Scheduler": "Hangfire",
      "ReleaseDelayDays": 3
    }
  },
  "Storage": {
    "Provider": "MinIO",
    "BaseUrl": "http://localhost:9000",
    "ProductsPrefix": "products",
    "AvatarsPrefix": "avatars",
    "ShopsPrefix": "shops",
    "ReviewsPrefix": "reviews",
    "MinIO": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "your-minio-access-key",
      "SecretKey": "your-minio-secret-key",
      "BucketName": "e-verland-media",
      "UseSsl": false
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "AccessKey": "your-aws-access-key",
    "SecretKey": "your-aws-secret-key",
    "SQS": {
      "OrderEventsQueueUrl": "https://sqs.us-east-1.amazonaws.com/your-account-id/order-events",
      "PaymentEventsQueueUrl": "https://sqs.us-east-1.amazonaws.com/your-account-id/payment-events",
      "ProductSyncQueueUrl": "https://sqs.us-east-1.amazonaws.com/your-account-id/product-sync",
      "ProductSyncDeadLetterQueueUrl": "https://sqs.us-east-1.amazonaws.com/your-account-id/product-sync-dlq",
      "MaxReceiveCount": 3
    },
    "S3": {
      "BucketName": "your-bucket-name",
      "BaseUrl": "https://your-bucket-name.s3.us-east-1.amazonaws.com"
    },
    "SNS": {
      "NotificationTopicArn": "arn:aws:sns:us-east-1:your-account-id:notification-topic",
      "OrderEventsTopicArn": "arn:aws:sns:us-east-1:your-account-id:order-events-topic",
      "PaymentEventsTopicArn": "arn:aws:sns:us-east-1:your-account-id:payment-events-topic",
      "ProductEventsTopicArn": "arn:aws:sns:us-east-1:your-account-id:product-events-topic"
    },
    "EventBridge": {
      "EventBusName": "e-verland-events",
      "OrderEventSource": "e-verland.orders",
      "PaymentEventSource": "e-verland.payments",
      "ProductEventSource": "e-verland.products"
    },
    "XRay": {
      "Enabled": true
    },
    "OpenSearch": {
      "Endpoint": "https://your-opensearch-endpoint",
      "Username": "your-username",
      "Password": "your-password"
    },
    "CloudWatch": {
      "Enabled": true,
      "LogGroupName": "/aws/e-verland/application",
      "LogStreamPrefix": "e-verland",
      "CreateLogGroup": true,
      "BatchSizeLimit": 100,
      "QueueSizeLimit": 10000,
      "PeriodSeconds": 10,
      "RetryAttempts": 5
    }
  }
}
