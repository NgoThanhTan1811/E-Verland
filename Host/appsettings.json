{
  "App": {
    "BackendUrl": "http://localhost:8080",
    "FrontendUrl": "http://localhost:3000"
  },
  "Jwt": {
    "Key": "your-jwt-key-min-32-chars-never-hardcode-in-production",
    "Issuer": "e-verland-platform",
    "Audience": "e-verland-platform",
    "AccessTokenMinutes": 10,
    "RefreshTokenHours": 12
  },
  "Cookie": {
    "Name": "access_token",
    "RefreshTokenName": "refresh_token",
    "Secure": true,
    "HttpOnly": true,
    "SameSite": "Lax",
    "Domain": "e-verland.site"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "https://e-verland.site"],
    "AllowCredentials": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "PayOS": {
    "ClientId": "your-payos-client-id",
    "ApiKey": "your-payos-api-key",
    "ChecksumKey": "your-payos-checksum-key",
    "ReturnUrl": "https://your-domain.com/payment/payos/return",
    "CancelUrl": "https://your-domain.com/payment/payos/cancel",
    "WebhookUrl": "https://your-domain.com/api/payos/webhook"
  },
  "AWS": {
    "Region": "us-east-1",
    "AccessKey": "your-aws-access-key",
    "SecretKey": "your-aws-secret-key",
    "SQS": {
      "OrderQueueUrl": "https://sqs.us-east-1.amazonaws.com/your-account-id/order-queue"
    },
    "S3": {
      "BucketName": "your-bucket-name"
    },
    "SNS": {
      "TopicArn": "arn:aws:sns:us-east-1:your-account-id:your-topic-name"
    },
    "XRay": {
      "Enabled": true
    },
    "OpenSearch": {
      "Endpoint": "https://your-opensearch-endpoint",
      "Username": "your-username",
      "Password": "your-password"
    },
    "CloudWatch": {
      "LogGroupName": "your-log-group-name",
      "LogStreamName": "your-log-stream-name"
    }
  }
}
