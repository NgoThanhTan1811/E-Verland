{
  "App": {
    "BackendUrl": "http://localhost:8080",
    "FrontendUrl": "http://localhost:3000"
  },
  "Jwt": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cookie": {
    "Name": "access_token",
    "RefreshTokenName": "refresh_token",
    "Secure": true,
    "HttpOnly": true,
    "SameSite": "Lax",
    "Domain": "e-verland.site"
  },
  "Cors": {
    "AllowCredentials": true
  },
  "Loki": {
    "Url": "http://loki:3100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "LocalFile": {
      "Enabled": true,
      "Path": "logs/e-verland-.ndjson",
      "MinimumLevel": "Warning",
      "RetainedFileCountLimit": 14
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Payment": {
    "SePay": {
      "BaseUrl": "https://pgapi.sepay.vn",
      "MaxRetries": 3
    },
    "Payout": {
      "Scheduler": "Hangfire",
      "ReleaseDelayDays": 3
    }
  },
  "GHN": {
    "MaxRetries": 3
  },
  "Storage": {
    "Provider": "S3",
    "ProductsPrefix": "products",
    "AvatarsPrefix": "avatars",
    "ShopsPrefix": "shops",
    "ReviewsPrefix": "reviews"
  },
  "Meilisearch": {
    "Endpoint": "http://meilisearch:7700",
    "IndexName": "products"
  },
  "Media": {
    "PresignedUrlExpirationMinutes": 10,
    "SmWidth": 480,
    "MdWidth": 1024,
    "LgWidth": 1920,
    "ImageCompressionQuality": 85,
    "OrphanGracePeriodHours": 24,
    "CleanupIntervalHours": 24
  },
  "Dashboard": {
    "RefreshIntervalMinutes": 15,
    "SnapshotTtlMinutes": 30,
    "StaleAfterMinutes": 15
  },
  "AWS": {
    "Region": "ap-southeast-1",
    "S3": {
      "BucketName": "e-verland-media",
      "Region": "auto",
      "ForcePathStyle": true,
      "AvatarPathPrefix": "avatars",
      "ProductImagePathPrefix": "products/images",
      "ProductVideoPathPrefix": "products/videos",
      "ShopLogoPathPrefix": "shops/logos",
      "ShopBannerPathPrefix": "shops/banners",
      "PreSignedUrlExpirationMinutes": 60
    },
    "EventBridge": {
      "EventBusName": "e-verland-events",
      "OrderEventSource": "e-verland.orders",
      "PaymentEventSource": "e-verland.payments",
      "ProductEventSource": "e-verland.products"
    },
    "XRay": {
      "Enabled": true
    },
    "CloudWatch": {
      "Enabled": true,
      "LogGroupName": "/ecs/e-verland-app",
      "LogStreamPrefix": "ecs",
      "CreateLogGroup": true,
      "BatchSizeLimit": 100,
      "QueueSizeLimit": 10000,
      "PeriodSeconds": 10,
      "RetryAttempts": 5
    }
  }
}
