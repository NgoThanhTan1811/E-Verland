{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "UserDb": "Host=${DB_HOST};Database=${USER_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}",
    "CatalogDb": "Host=${DB_HOST};Database=${CATALOG_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}",
    "ProductDb": "Host=${DB_HOST};Database=${PRODUCT_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}",
    "AuthDb": "Host=${DB_HOST};Database=${AUTH_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}",
    "PaymentDb": "Host=${DB_HOST};Database=${PAYMENT_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}",
    "CheckoutDb": "Host=${DB_HOST};Database=${CHECKOUT_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}",
    "OrderDb": "Host=${DB_HOST};Database=${ORDER_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}",
    "CartDb": "Host=${DB_HOST};Database=${CART_DB};Username=${DB_USERNAME};Password=${DB_PASSWORD}"
  }
}
